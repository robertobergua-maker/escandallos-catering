# Copiar a deploy/.env y rellenar (no se sube a git).
# Fase de pruebas: solo el subdominio provisional.
# Tras el cambio de DNS: escandallos.samirarte.com, nuevo-escandallos.escandallos.samirarte.com
APP_DOMAIN=nuevo-escandallos.escandallos.samirarte.com
# Ruta del secrets.toml en la VM (fuera del repo, permisos 600).
SECRETS_FILE=/opt/escandallos/secrets/secrets.toml
# Solo para el perfil "keepalive" (clave anon/publishable).
SUPABASE_URL=
SUPABASE_KEY=
