# Copiar a deploy/.env y rellenar (no se sube a git).
# Dominios que sirven la app: el definitivo y el provisional.
APP_DOMAIN=escandallos.samirarte.com, nuevo-escandallos.escandallos.samirarte.com
# Alias que redirige (301) al dominio canónico.
REDIRECT_DOMAIN=www.escandallos.samirarte.com
CANONICAL_DOMAIN=escandallos.samirarte.com
# Ruta del secrets.toml en la VM (fuera del repo, permisos 600).
SECRETS_FILE=/opt/escandallos/secrets/secrets.toml
# Solo para el perfil "keepalive" (clave anon/publishable).
SUPABASE_URL=
SUPABASE_KEY=
