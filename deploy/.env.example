# Copiar a deploy/.env y rellenar (no se sube a git).

# Dominios de producción que sirven la app.
# No incluir nuevo-escandallos aquí: ese dominio lo gestiona PRUEBAS_DOMAIN
# y Caddy rechaza dominios duplicados entre bloques.
APP_DOMAIN=escandallos.samirarte.com
# Alias que redirige (301) al dominio canónico.
REDIRECT_DOMAIN=www.escandallos.samirarte.com
CANONICAL_DOMAIN=escandallos.samirarte.com

# Dominio del entorno de pruebas (rama multiorganizacion).
# Cuando APP_DOMAIN ya incluya nuevo-escandallos, quitar ese nombre de APP_DOMAIN
# y dejar solo PRUEBAS_DOMAIN apuntando a app-pruebas.
PRUEBAS_DOMAIN=nuevo-escandallos.escandallos.samirarte.com

# Ruta del secrets.toml de producción en la VM (fuera del repo, permisos 600).
SECRETS_FILE=/opt/escandallos/secrets/secrets.toml

# Ruta del secrets.toml del entorno de pruebas (copia con URLs actualizadas).
SECRETS_FILE_PRUEBAS=/opt/escandallos/secrets/secrets-pruebas.toml

# Solo para el perfil "keepalive" (clave anon/publishable).
SUPABASE_URL=
SUPABASE_KEY=
